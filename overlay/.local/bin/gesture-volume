#!/usr/bin/env bash
# Live volume for the 4-finger swipe (media-gestures.lua): gesture-volume <+-percent>
# Applies the change inside the running shell (timon.audio IPC "nudge": the same
# in-process PipeWire path and OSD as the bar wheel and the popup slider), so no
# sink lookups, wpctl reads or OSD processes sit in the hot path. Deltas that
# arrive while one call is in flight are summed and sent as one call.
set -uo pipefail
RT="${XDG_RUNTIME_DIR:-/tmp}"
PEND="$RT/gesture-volume.pending"; PLOCK="$RT/gesture-volume.plock"; LOCK="$RT/gesture-volume.lock"
[[ ${1:-} =~ ^[+-]?[0-9.]+$ ]] || { sed -n '2,6p' "$0"; exit 1; }

( flock 8; echo "$1" >>"$PEND" ) 8>"$PLOCK"
exec 9>"$LOCK"; flock -n 9 || exit 0
while :; do
  sum=$( ( flock 8; if [[ -s $PEND ]]; then awk '{s+=$1} END{printf "%.3f", s}' "$PEND"; : >"$PEND"; else echo 0; fi ) 8>"$PLOCK")
  case $sum in 0|0.000|-0.000) break ;; esac
  quickshell ipc -p "${OMARCHY_PATH:-/usr/share/omarchy}/shell" call timon.audio nudge "$sum" >/dev/null 2>&1
done
