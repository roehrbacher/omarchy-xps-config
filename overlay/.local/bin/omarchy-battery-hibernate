#!/bin/bash
# Managed by omarchy-xps-config. Save the session to disk (hibernate), used by
# timon.battery's last-chance countdown and for testing by hand:
#
#   omarchy-battery-hibernate            lock, end Insomnia, hibernate (suspend if that fails)
#   omarchy-battery-hibernate --dry-run  only print what it would do
#
# The laptop turns off completely; press power to resume at the lock screen.
#
# Insomnia holds a "sleep" block lock, which also blocks hibernate. Its unit is
# stopped directly (not via `omarchy-insomnia stop`): without a stop reason its
# end hook does nothing, so it cannot start a suspend of its own (lid closed on
# battery) that would race this hibernate. `systemctl hibernate -i` is not used:
# ignoring inhibitors needs an admin password prompt under polkit's defaults.
set -u
DRY=0
[[ ${1:-} == --dry-run ]] && DRY=1
run() { if (( DRY )); then echo "would run: $*"; else "$@"; fi; }

run omarchy-system-lock
(( DRY )) || sleep 1
if systemctl --user is-active --quiet omarchy-insomnia.service; then
  run systemctl --user stop omarchy-insomnia.service
fi
if (( DRY )); then
  echo "would run: systemctl hibernate || systemctl suspend"
  exit 0
fi
if ! systemctl hibernate; then
  logger -t omarchy-battery-hibernate "hibernate failed, suspending instead"
  omarchy-notification-send -u critical "Hibernate failed" "Suspending instead." >/dev/null 2>&1 || true
  systemctl suspend
fi
